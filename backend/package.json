{
  "name": "civicpath-maharashtra-backend",
  "version": "0.1.0",
  "description": "Backend that turns natural-language civic requests into source-grounded, verified workflows for Maharashtra municipalities.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "dev:watch": "node --watch --watch-path=src src/server.js",
    "test": "node --test tests/**/*.test.js",
    "test:filestack:live": "node scripts/filestack-live-smoke.js",
    "seed": "node src/data/seed.js",
    "ingest": "node scripts/batch-ingest-sources.js"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^1.6.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "node-fetch": "^2.7.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=18"
  }
}
