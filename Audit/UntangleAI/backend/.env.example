# Server
PORT=5000
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=UntangleAI/1.0 (https://github.com/noushad213/UntangleAI)
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/civicpath

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Security
ADMIN_API_TOKEN=replace_with_a_long_random_secret
ADMIN_REVIEWER_ID=admin@example.gov.in
CORS_ALLOWED_ORIGINS=http://localhost:3000
QUERY_RATE_WINDOW_MS=60000
QUERY_RATE_MAX=10
WORKFLOW_FRESHNESS_MS=604800000
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=2000000
ALLOWED_REDIRECTS=3
SOURCE_USER_AGENT=CivicPathBot/1.0 (+source-grounded civic workflow assistant)

# Source quality and optional JavaScript rendering fallback
MIN_SOURCE_TEXT_CHARS=160
MIN_SOURCE_TEXT_WORDS=25
MAX_ALTERNATE_SOURCES=3
# Keep false unless Playwright/Chromium is installed in the deployment image.
ENABLE_BROWSER_FALLBACK=false

# Optional FileStack normalization fallback; native extraction remains primary.
ENABLE_FILESTACK_FALLBACK=false
FILESTACK_API_KEY=your_filestack_api_key_here
FILESTACK_OUTPUT_FORMAT=txt
FILESTACK_TIMEOUT_MS=15000
FILESTACK_MAX_BYTES=2000000
# Set only when FileStack security is enabled for the application.
FILESTACK_POLICY=
FILESTACK_SIGNATURE=

# Free local extraction tools (install tesseract-ocr, poppler-utils, libreoffice)
ENABLE_LOCAL_OCR=true
OCR_LANG=eng
OCR_MAX_PAGES=10
OCR_DPI=180
OCR_TIMEOUT_MS=120000
ENABLE_OFFICE_CONVERSION=true
OFFICE_TIMEOUT_MS=20000

# Page-aware civic chunks supplied to Gemini
CIVIC_CHUNK_SIZE=3500
CIVIC_CHUNK_OVERLAP=400
MAX_GEMINI_CHUNKS_PER_SOURCE=8
MAX_SOURCES_PER_WORKFLOW=8
SOURCE_SEARCH_RESULT_LIMIT=10

# OCR Space (Document Type Verification)
OCR_SPACE_API_KEY=K81528165388957
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
OCR_SPACE_ENGINE=3
OCR_SPACE_TIMEOUT_MS=30000
DOCUMENT_UPLOAD_MAX_BYTES=8000000
